DEFINE SCHEMA

    RECORD TYPE CD_AuditedClause (
        CD_audit                               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_category                            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_category_ckAsset                    ASSET,
        CD_clauseNumberAndTitle                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_clauseNumberAndTitle_ckAsset        ASSET,
        CD_decisionStatusRaw                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_decisionStatusRaw_ckAsset           ASSET,
        CD_entityName                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset                 ASSET,
        CD_negotiationTalkingPoint             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_negotiationTalkingPoint_ckAsset     ASSET,
        CD_originalQuote                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_originalQuote_ckAsset               ASSET,
        CD_plainEnglishImpact                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_plainEnglishImpact_ckAsset          ASSET,
        CD_priorityOrder                       INT64 QUERYABLE SORTABLE,
        CD_severityRaw                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_severityRaw_ckAsset                 ASSET,
        CD_suggestedRedlineReplacement         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_suggestedRedlineReplacement_ckAsset ASSET,
        "___createTime"                        TIMESTAMP,
        "___createdBy"                         REFERENCE,
        "___etag"                              STRING,
        "___modTime"                           TIMESTAMP,
        "___modifiedBy"                        REFERENCE,
        "___recordID"                          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_ContractAudit (
        CD_contractCategory               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_contractCategory_ckAsset       ASSET,
        CD_counterpartyName               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_counterpartyName_ckAsset       ASSET,
        CD_createdAt                      TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_executiveSummary               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_executiveSummary_ckAsset       ASSET,
        CD_id                             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_missingProtectionsJSON         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_missingProtectionsJSON_ckAsset ASSET,
        CD_moveReceipt                    BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset            ASSET,
        CD_originalPDFData                BYTES QUERYABLE SORTABLE,
        CD_originalPDFData_ckAsset        ASSET,
        CD_overallRiskScore               INT64 QUERYABLE SORTABLE,
        CD_previousVersionText            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_previousVersionText_ckAsset    ASSET,
        CD_rawContractText                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rawContractText_ckAsset        ASSET,
        CD_selectedRolePlaybook           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_selectedRolePlaybook_ckAsset   ASSET,
        CD_title                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset                  ASSET,
        "___createTime"                   TIMESTAMP,
        "___createdBy"                    REFERENCE,
        "___etag"                         STRING,
        "___modTime"                      TIMESTAMP,
        "___modifiedBy"                   REFERENCE,
        "___recordID"                     REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
