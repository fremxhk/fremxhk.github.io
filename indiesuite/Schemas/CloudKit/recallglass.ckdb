DEFINE SCHEMA

    RECORD TYPE CD_FSRSFlashcard (
        CD_canonicalAnswer            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_canonicalAnswer_ckAsset    ASSET,
        CD_cardStyleRaw               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_cardStyleRaw_ckAsset       ASSET,
        CD_deck                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_difficultyScore            DOUBLE QUERYABLE SORTABLE,
        CD_elapsedDaysSinceLastReview DOUBLE QUERYABLE SORTABLE,
        CD_entityName                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_keyConceptsCSV             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_keyConceptsCSV_ckAsset     ASSET,
        CD_lapsesCount                INT64 QUERYABLE SORTABLE,
        CD_lastReviewDate             TIMESTAMP QUERYABLE SORTABLE,
        CD_moveReceipt                BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset        ASSET,
        CD_nextReviewDate             TIMESTAMP QUERYABLE SORTABLE,
        CD_promptQuestion             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_promptQuestion_ckAsset     ASSET,
        CD_reviewCount                INT64 QUERYABLE SORTABLE,
        CD_scheduledIntervalDays      INT64 QUERYABLE SORTABLE,
        CD_stabilityDays              DOUBLE QUERYABLE SORTABLE,
        "___createTime"               TIMESTAMP,
        "___createdBy"                REFERENCE,
        "___etag"                     STRING,
        "___modTime"                  TIMESTAMP,
        "___modifiedBy"               REFERENCE,
        "___recordID"                 REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SpeakerCueCard (
        CD_bulletPointsJSON                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_bulletPointsJSON_ckAsset         ASSET,
        CD_cumulativeEndSeconds             INT64 QUERYABLE SORTABLE,
        CD_cumulativeStartSeconds           INT64 QUERYABLE SORTABLE,
        CD_deliveryCuesCSV                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_deliveryCuesCSV_ckAsset          ASSET,
        CD_entityName                       STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_estimatedDurationSeconds         INT64 QUERYABLE SORTABLE,
        CD_id                               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt                      BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset              ASSET,
        CD_openingTransitionCue             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_openingTransitionCue_ckAsset     ASSET,
        CD_originalParagraphExcerpt         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_originalParagraphExcerpt_ckAsset ASSET,
        CD_project                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sectionHeadline                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sectionHeadline_ckAsset          ASSET,
        CD_sequenceNumber                   INT64 QUERYABLE SORTABLE,
        CD_verbatimKeyQuote                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_verbatimKeyQuote_ckAsset         ASSET,
        CD_wordCountRepresented             INT64 QUERYABLE SORTABLE,
        "___createTime"                     TIMESTAMP,
        "___createdBy"                      REFERENCE,
        "___etag"                           STRING,
        "___modTime"                        TIMESTAMP,
        "___modifiedBy"                     REFERENCE,
        "___recordID"                       REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_SpeechProject (
        CD_createdAt                     TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_fontScaleMultiplier           DOUBLE QUERYABLE SORTABLE,
        CD_id                            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_includeCutMarksAndPasteGuides INT64 QUERYABLE SORTABLE,
        CD_moveReceipt                   BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset           ASSET,
        CD_occasionOrAudience            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_occasionOrAudience_ckAsset    ASSET,
        CD_preferredCardSizeRaw          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_preferredCardSizeRaw_ckAsset  ASSET,
        CD_preferredPaperSizeRaw         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_preferredPaperSizeRaw_ckAsset ASSET,
        CD_rawSpeechManuscript           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_rawSpeechManuscript_ckAsset   ASSET,
        CD_targetSpeakingWPM             INT64 QUERYABLE SORTABLE,
        CD_title                         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset                 ASSET,
        "___createTime"                  TIMESTAMP,
        "___createdBy"                   REFERENCE,
        "___etag"                        STRING,
        "___modTime"                     TIMESTAMP,
        "___modifiedBy"                  REFERENCE,
        "___recordID"                    REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_StudyDeck (
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_sourceText          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceText_ckAsset  ASSET,
        CD_title               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_title_ckAsset       ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
