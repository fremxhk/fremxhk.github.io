DEFINE SCHEMA

    RECORD TYPE CD_TaxExpenseRecord (
        CD_attendeesAndRelationship          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_attendeesAndRelationship_ckAsset  ASSET,
        CD_auditDefenseJustification         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_auditDefenseJustification_ckAsset ASSET,
        CD_auditRiskLevelRaw                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_auditRiskLevelRaw_ckAsset         ASSET,
        CD_businessPurposeMemo               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_businessPurposeMemo_ckAsset       ASSET,
        CD_deductiblePercentage              DOUBLE QUERYABLE SORTABLE,
        CD_entityName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_grossAmount                       DOUBLE QUERYABLE SORTABLE,
        CD_id                                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isVerifiedForFiling               INT64 QUERYABLE SORTABLE,
        CD_merchant                          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_merchant_ckAsset                  ASSET,
        CD_moveReceipt                       BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset               ASSET,
        CD_receiptData                       BYTES QUERYABLE SORTABLE,
        CD_receiptData_ckAsset               ASSET,
        CD_scheduleCCategory                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_scheduleCCategory_ckAsset         ASSET,
        CD_sourceText                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_sourceText_ckAsset                ASSET,
        CD_transactionDate                   TIMESTAMP QUERYABLE SORTABLE,
        CD_transactionDateISO                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_transactionDateISO_ckAsset        ASSET,
        "___createTime"                      TIMESTAMP,
        "___createdBy"                       REFERENCE,
        "___etag"                            STRING,
        "___modTime"                         TIMESTAMP,
        "___modifiedBy"                      REFERENCE,
        "___recordID"                        REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_TaxProfileAndWorkspaceConfig (
        CD_annualActualVehicleExpenses  DOUBLE QUERYABLE SORTABLE,
        CD_annualBusinessMiles          DOUBLE QUERYABLE SORTABLE,
        CD_annualRentOrMortgageInterest DOUBLE QUERYABLE SORTABLE,
        CD_annualTotalVehicleMiles      DOUBLE QUERYABLE SORTABLE,
        CD_annualUtilitiesAndInsurance  DOUBLE QUERYABLE SORTABLE,
        CD_entityName                   STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_estimatedMarginalTaxRate     DOUBLE QUERYABLE SORTABLE,
        CD_homeOfficeSqFt               DOUBLE QUERYABLE SORTABLE,
        CD_homeTotalSqFt                DOUBLE QUERYABLE SORTABLE,
        CD_id                           STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_jurisdiction                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_jurisdiction_ckAsset         ASSET,
        CD_moveReceipt                  BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset          ASSET,
        CD_secondHalf2026BusinessMiles  DOUBLE QUERYABLE SORTABLE,
        CD_taxYear                      INT64 QUERYABLE SORTABLE,
        "___createTime"                 TIMESTAMP,
        "___createdBy"                  REFERENCE,
        "___etag"                       STRING,
        "___modTime"                    TIMESTAMP,
        "___modifiedBy"                 REFERENCE,
        "___recordID"                   REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
