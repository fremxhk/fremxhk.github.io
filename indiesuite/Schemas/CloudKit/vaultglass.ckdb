DEFINE SCHEMA

    RECORD TYPE CD_InventoryItem (
        CD_archived                        INT64 QUERYABLE SORTABLE,
        CD_barcodePayload                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_barcodePayload_ckAsset          ASSET,
        CD_baseWarrantyMonths              INT64 QUERYABLE SORTABLE,
        CD_category                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_category_ckAsset                ASSET,
        CD_creditCardBenefitMonths         INT64 QUERYABLE SORTABLE,
        CD_diagnosticChecklistJSON         STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_diagnosticChecklistJSON_ckAsset ASSET,
        CD_entityName                      STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_expectedLifespanYears           INT64 QUERYABLE SORTABLE,
        CD_id                              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_isPinned                        INT64 QUERYABLE SORTABLE,
        CD_itemPhotoData                   BYTES QUERYABLE SORTABLE,
        CD_itemPhotoData_ckAsset           ASSET,
        CD_merchant                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_merchant_ckAsset                ASSET,
        CD_modelNumber                     STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_modelNumber_ckAsset             ASSET,
        CD_moveReceipt                     BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset             ASSET,
        CD_name                            STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_name_ckAsset                    ASSET,
        CD_paymentCardName                 STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_paymentCardName_ckAsset         ASSET,
        CD_priorityOrder                   INT64 QUERYABLE SORTABLE,
        CD_propertyName                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_propertyName_ckAsset            ASSET,
        CD_purchaseDate                    TIMESTAMP QUERYABLE SORTABLE,
        CD_purchasePrice                   DOUBLE QUERYABLE SORTABLE,
        CD_receiptMediaData                BYTES QUERYABLE SORTABLE,
        CD_receiptMediaData_ckAsset        ASSET,
        CD_replacementCost                 DOUBLE QUERYABLE SORTABLE,
        CD_returnWindowDays                INT64 QUERYABLE SORTABLE,
        CD_roomName                        STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_roomName_ckAsset                ASSET,
        CD_serialNumber                    STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_serialNumber_ckAsset            ASSET,
        CD_supportContactURL               STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_supportContactURL_ckAsset       ASSET,
        "___createTime"                    TIMESTAMP,
        "___createdBy"                     REFERENCE,
        "___etag"                          STRING,
        "___modTime"                       TIMESTAMP,
        "___modifiedBy"                    REFERENCE,
        "___recordID"                      REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE CD_WarrantyClaimLog (
        CD_body                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_body_ckAsset        ASSET,
        CD_createdAt           TIMESTAMP QUERYABLE SORTABLE,
        CD_entityName          STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_id                  STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_item                STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_moveReceipt         BYTES QUERYABLE SORTABLE,
        CD_moveReceipt_ckAsset ASSET,
        CD_status              STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_status_ckAsset      ASSET,
        CD_subject             STRING QUERYABLE SEARCHABLE SORTABLE,
        CD_subject_ckAsset     ASSET,
        "___createTime"        TIMESTAMP,
        "___createdBy"         REFERENCE,
        "___etag"              STRING,
        "___modTime"           TIMESTAMP,
        "___modifiedBy"        REFERENCE,
        "___recordID"          REFERENCE,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
